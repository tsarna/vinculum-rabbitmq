# Where the compose broker in ci/brokers.yml can be reached, in the form the
# integration tests read. Source it with `set -a` so the assignments are
# exported:
#
#   set -a; . ci/rabbitmq.env; set +a
#   go test -race -tags integration ./client/...
#
# These credentials are in the definitions file next to them; they guard
# nothing.

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=vinculum

# Also the management API user. Tagged management in
# ci/rabbitmq/definitions.json, which is enough to list and close its own
# connections and delete queues on a vhost it can configure.
RABBITMQ_USER=vinculum
RABBITMQ_PASS=vinculum

RABBITMQ_MGMT_URL=http://localhost:15672
